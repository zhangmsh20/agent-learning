# 默认所有实验都走本地 Mock，不需要任何账号或费用。
AI_AGENT_USE_MOCK=true
AI_AGENT_SIMULATE_TIMEOUT=false

# 仅在 tool_calling.py 的真实模型实验中使用。
ANTHROPIC_API_KEY=
# 仅作示例；模型名称、思考参数和价格会变化，使用前核对官方模型页。
ANTHROPIC_MODEL=claude-sonnet-5

# 仅在 eval_pipeline.py 上传评估结果时使用。
AI_AGENT_USE_LANGSMITH=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-evals-demo
